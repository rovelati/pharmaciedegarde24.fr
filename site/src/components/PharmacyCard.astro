---
export interface Props {
  pharmacy: {
    id: string;
    nom: string;
    slug: string;
    adresse: string;
    codePostal: string;
    ville: string;
    departementCode: string;
    lat: number | null;
    lon: number | null;
    telephone: string;
    isOpen24h?: boolean;
    shifts?: Array<{
      type: string;
      debut: string;
      fin: string;
      notes: string;
    }>;
  };
  showDetailLink?: boolean;
}

const { pharmacy, showDetailLink = true } = Astro.props;

// Calculate current status
const now = new Date();
const activeShift = (pharmacy.shifts || []).find(s => {
  const d = new Date(s.debut);
  const f = new Date(s.fin);
  return now >= d && now <= f;
});

const isNightShift = activeShift && activeShift.type === 'nuit';
const isSundayShift = activeShift && activeShift.type === 'dimanche';
const is24h = pharmacy.isOpen24h;

const mapUrl = (pharmacy.lat && pharmacy.lon)
  ? `https://www.google.com/maps/dir/?api=1&destination=${pharmacy.lat},${pharmacy.lon}`
  : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(pharmacy.nom + ' ' + pharmacy.adresse)}`;
---

<div class={`card pharmacy-card ${activeShift ? 'is-garde' : ''}`}>
  <div class="card-header">
    <div class="status-row">
      {is24h ? (
        <span class="badge badge-open">
          <span class="pulse-dot"></span>
          Ouverte 24h/24
        </span>
      ) : isNightShift ? (
        <span class="badge badge-night">
          <span class="pulse-dot"></span>
          De garde cette nuit
        </span>
      ) : isSundayShift ? (
        <span class="badge badge-garde">
          <span class="pulse-dot"></span>
          De garde aujourd'hui
        </span>
      ) : (
        <span class="badge badge-open">
          Officine référencée
        </span>
      )}
      <span class="dept-badge">Dép. {pharmacy.departementCode}</span>
    </div>

    <h3 class="pharma-nom">
      {showDetailLink ? (
        <a href={`/pharmacie/${pharmacy.slug}/`}>{pharmacy.nom}</a>
      ) : (
        pharmacy.nom
      )}
    </h3>
    <p class="pharma-adresse">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
        <circle cx="12" cy="9" r="2.5"/>
      </svg>
      <span>{pharmacy.adresse}</span>
    </p>
  </div>

  {activeShift && (
    <div class="shift-info">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
        <path d="M12 2a10 10 0 1010 10A10 10 0 0012 2zm1 14h-2v-2h2zm0-4h-2V7h2z"/>
      </svg>
      <span>{activeShift.notes}</span>
    </div>
  )}

  <div class="card-actions">
    {pharmacy.telephone ? (
      <a href={`tel:${pharmacy.telephone.replace(/\s+/g, '')}`} class="btn btn-phone" title={`Appeler ${pharmacy.nom}`}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
        </svg>
        <span>{pharmacy.telephone}</span>
      </a>
    ) : (
      <a href="tel:3237" class="btn btn-outline" title="Contacter le 3237">
        <span>Appeler le 3237</span>
      </a>
    )}

    <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline" title="Calculer l'itinéraire">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
        <polygon points="3 11 22 2 13 21 11 13 3 11"/>
      </svg>
      <span>Itinéraire</span>
    </a>
  </div>
</div>

<style>
  .pharmacy-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
  }
  .is-garde {
    border-color: var(--gold);
    box-shadow: 0 4px 14px rgba(217, 119, 6, 0.15);
  }
  .status-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }
  .dept-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--muted);
  }
  .pharma-nom {
    font-size: 1.15rem;
    margin: 0 0 6px;
    font-weight: 700;
  }
  .pharma-nom a {
    color: var(--ink);
  }
  .pharma-nom a:hover {
    color: var(--cross);
  }
  .pharma-adresse {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    font-size: 0.9rem;
    color: var(--ink-secondary);
    margin: 0;
  }
  .pharma-adresse svg {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--muted);
  }
  .shift-info {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--gold-bg);
    border: 1px solid var(--gold-border);
    color: var(--gold);
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .card-actions {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 8px;
    margin-top: 6px;
  }
  @media (max-width: 480px) {
    .card-actions {
      grid-template-columns: 1fr;
    }
  }
</style>
