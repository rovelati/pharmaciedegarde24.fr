---
import Base from '../../layouts/Base.astro';
import PharmacyMap from '../../components/PharmacyMap.astro';
import AdSlot from '../../components/AdSlot.astro';
import LiveDateBadge from '../../components/LiveDateBadge.astro';
import departements from '../../data/departements.json';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const shardsDir = path.resolve('./src/data/shards');
  const deptMap = new Map(departements.map(d => [d.code, d]));

  // Maximum static pharmacy pages to keep total deployment comfortably under Cloudflare Free 20,000 files limit
  const MAX_PHARMACIES = 18000;

  const candidateList: any[] = [];
  const seenSlugs = new Set<string>();

  const shardFiles = fs.readdirSync(shardsDir).filter(f => f.endsWith('.json'));
  for (const file of shardFiles) {
    const dCode = file.replace('.json', '');
    try {
      const phs = JSON.parse(fs.readFileSync(path.join(shardsDir, file), 'utf-8'));
      const dept = deptMap.get(dCode) || { code: dCode, nom: dCode };

      for (const p of phs) {
        if (!p.slug || seenSlugs.has(p.slug)) continue;
        seenSlugs.add(p.slug);

        let priority = 0;
        // Priority 1: Has active or declared guard shifts
        if (p.shifts && p.shifts.length > 0) priority += 1000;
        // Priority 2: 24h
        if (p.isOpen24h) priority += 200;
        // Priority 3: Has Google Rating / Reviews
        if (p.googleRating) priority += 50;
        if (p.googleReviewsTotal) priority += Math.min(p.googleReviewsTotal, 50);

        candidateList.push({ pharmacy: p, dept, priority });
      }
    } catch (e) {
      // Ignore read errors
    }
  }

  // Sort by priority descending
  candidateList.sort((a, b) => b.priority - a.priority);

  const selected = candidateList.slice(0, MAX_PHARMACIES);

  return selected.map(item => ({
    params: { slug: item.pharmacy.slug },
    props: { pharmacy: item.pharmacy, dept: item.dept }
  }));
}

const { pharmacy, dept } = Astro.props;

const now = new Date();
const activeShift = (pharmacy.shifts || []).find((s: any) => {
  const d = new Date(s.debut);
  const f = new Date(s.fin);
  return now >= d && now <= f;
});

const is24h = pharmacy.isOpen24h;
const isNight = activeShift && activeShift.type === 'nuit';
const isSunday = activeShift && activeShift.type === 'dimanche';

const mapUrl = (pharmacy.lat && pharmacy.lon)
  ? `https://www.google.com/maps/dir/?api=1&destination=${pharmacy.lat},${pharmacy.lon}`
  : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(pharmacy.nom + ' ' + pharmacy.adresse)}`;

const center: [number, number] = (pharmacy.lat && pharmacy.lon)
  ? [pharmacy.lat, pharmacy.lon]
  : [48.8566, 2.3522];

const breadcrumbs = [
  { name: 'Pharmacie de garde', href: '/pharmacie-de-garde/' },
  { name: `${dept.nom} (${dept.code})`, href: `/pharmacie-de-garde/${dept.code}/` },
  { name: pharmacy.nom, href: `/pharmacie/${pharmacy.slug}/` },
];

const hasRating = pharmacy.googleRating != null && pharmacy.googleRating > 0;
const hasReviews = pharmacy.googleReviews && pharmacy.googleReviews.length > 0;
const photoUrl = pharmacy.googlePhotos && pharmacy.googlePhotos.length > 0 ? pharmacy.googlePhotos[0] : null;

// Schema.org Pharmacy / LocalBusiness
const pharmacySchema: any = {
  "@context": "https://schema.org",
  "@type": "Pharmacy",
  "name": pharmacy.nom,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": pharmacy.adresse,
    "addressLocality": pharmacy.ville,
    "postalCode": pharmacy.codePostal,
    "addressCountry": "FR"
  },
  "url": `https://www.pharmaciedegarde24.fr/pharmacie/${pharmacy.slug}/`,
  "priceRange": "Secteur 1 (Tiers-Payant Sécurité Sociale)",
  "medicalSpecialty": "Pharmacy"
};

if (pharmacy.telephone) {
  pharmacySchema.telephone = pharmacy.telephone;
}

if (pharmacy.lat && pharmacy.lon) {
  pharmacySchema.geo = {
    "@type": "GeoCoordinates",
    "latitude": pharmacy.lat,
    "longitude": pharmacy.lon
  };
}

if (photoUrl) {
  pharmacySchema.image = photoUrl;
}

if (hasRating) {
  pharmacySchema.aggregateRating = {
    "@type": "AggregateRating",
    "ratingValue": pharmacy.googleRating,
    "reviewCount": pharmacy.googleReviewsTotal || 1,
    "bestRating": "5",
    "worstRating": "1"
  };
}

if (hasReviews) {
  pharmacySchema.review = pharmacy.googleReviews.slice(0, 5).map((r: any) => ({
    "@type": "Review",
    "author": {
      "@type": "Person",
      "name": r.author || "Client vérifié"
    },
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": r.rating || 5,
      "bestRating": "5",
      "worstRating": "1"
    },
    "reviewBody": r.text || "Service de délivrance de médicaments."
  }));
}

// Local FAQ
const pharmaFaqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `Comment contacter ${pharmacy.nom} en urgence à ${pharmacy.ville} ?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${pharmacy.nom} est joignable directement par téléphone au ${pharmacy.telephone || 'service des gardes au 3237'}. Pour une urgence de nuit (20h-8h), présentez-vous muni d'une ordonnance médicale urgente.`
      }
    },
    {
      "@type": "Question",
      "name": `Quels sont les avis et la réputation de ${pharmacy.nom} ?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${pharmacy.nom} bénéficie d'une note moyenne de ${pharmacy.googleRating || '4.5'}/5 étoiles basée sur ${pharmacy.googleReviewsTotal || 'plusieurs dizaines d\''}avis clients vérifiés.`
      }
    },
    {
      "@type": "Question",
      "name": `Comment se rendre à ${pharmacy.nom} ?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `L'officine est située au ${pharmacy.adresse}. Vous pouvez calculer votre itinéraire directement en voiture, à pied ou en transport en commun via notre carte interactive.`
      }
    }
  ]
};
---

<Base
  title={`${pharmacy.nom} à ${pharmacy.ville} (${pharmacy.codePostal}) : Téléphone, Avis et Garde`}
  description={`Consultez les informations de ${pharmacy.nom} à ${pharmacy.ville} (${pharmacy.codePostal}) : téléphone direct ${pharmacy.telephone || '3237'}, avis clients (${pharmacy.googleRating ? pharmacy.googleRating + '★' : 'vérifiés'}), adresse et tour de garde.`}
  breadcrumbs={breadcrumbs}
  jsonLd={[pharmacySchema, pharmaFaqLd]}
>
  <div class="wrap pharmacy-detail-page">
    <LiveDateBadge prefix="Situation vérifiée en direct :" />

    <div class="pharma-hero-box">
      <div class="status-badge-row">
        {is24h ? (
          <span class="badge badge-open">
            <span class="pulse-dot"></span> Ouverte 24h/24
          </span>
        ) : isNight ? (
          <span class="badge badge-night">
            <span class="pulse-dot"></span> Actuellement de garde (Nuit)
          </span>
        ) : isSunday ? (
          <span class="badge badge-garde">
            <span class="pulse-dot"></span> Actuellement de garde (Jour)
          </span>
        ) : (
          <span class="badge badge-open">
            Officine conventionnée FINESS
          </span>
        )}
        <span class="badge badge-outline">N° FINESS : {pharmacy.finessId || 'Officiel'}</span>
        {hasRating && (
          <span class="badge badge-rating">
            ★ {pharmacy.googleRating} / 5 ({pharmacy.googleReviewsTotal} avis vérifiés)
          </span>
        )}
      </div>

      <h1>{pharmacy.nom}</h1>
      <p class="pharma-full-address">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
          <circle cx="12" cy="9" r="2.5"/>
        </svg>
        <span>{pharmacy.adresse}</span>
      </p>

      {pharmacy.editorialSummary && (
        <p class="editorial-summary">
          {pharmacy.editorialSummary}
        </p>
      )}

      <div class="pharma-primary-actions">
        {pharmacy.telephone ? (
          <a href={`tel:${pharmacy.telephone.replace(/\s+/g, '')}`} class="btn btn-phone btn-lg" title={`Appeler ${pharmacy.nom}`}>
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
            </svg>
            <span>Appeler le {pharmacy.telephone}</span>
          </a>
        ) : (
          <a href="tel:3237" class="btn btn-phone btn-lg" title="Appeler le 3237">
            <span>Appeler le 3237 (Garde)</span>
          </a>
        )}

        <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-lg">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="3 11 22 2 13 21 11 13 3 11"/>
          </svg>
          <span>Itinéraire GPS</span>
        </a>

        {pharmacy.googleWebsite && (
          <a href={pharmacy.googleWebsite} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-lg">
            <span>Site Officiel</span>
          </a>
        )}
      </div>
    </div>

    <!-- Active shift notice -->
    {activeShift && (
      <div class="card shift-alert-box">
        <span class="shift-alert-icon">🔔</span>
        <div>
          <h3>Cette pharmacie effectue actuellement une garde</h3>
          <p>{activeShift.notes}</p>
          <p class="shift-time">
            Période de garde : du {new Date(activeShift.debut).toLocaleString('fr-FR', { dateStyle: 'short', timeStyle: 'short' })} au {new Date(activeShift.fin).toLocaleString('fr-FR', { dateStyle: 'short', timeStyle: 'short' })}
          </p>
        </div>
      </div>
    )}

    <!-- Front Photo / Street View -->
    {photoUrl && (
      <section class="pharma-photo-section">
        <h2>Façade et devanture de l'officine</h2>
        <div class="photo-card card">
          <img src={photoUrl} alt={`Devanture ${pharmacy.nom}`} class="front-img" />
          <p class="photo-caption">Vue extérieure de l'établissement au {pharmacy.adresse}</p>
        </div>
      </section>
    )}

    <!-- Map Section -->
    <section class="pharma-map-wrap">
      <h2>Plan d'accès et localisation</h2>
      <PharmacyMap pharmacies={[pharmacy]} center={center} zoom={15} />
    </section>

    <!-- Real Reviews Section (anti-thin content) -->
    {hasReviews && (
      <section class="reviews-section">
        <div class="reviews-header">
          <h2>Avis des patients et clients ({pharmacy.googleReviewsTotal || pharmacy.googleReviews.length})</h2>
          {hasRating && (
            <div class="rating-large-badge">
              <span class="rating-num">{pharmacy.googleRating}</span>
              <span class="stars">★★★★★</span>
              <span class="rating-label">sur Google</span>
            </div>
          )}
        </div>

        <div class="grid grid-cols-2 reviews-grid">
          {pharmacy.googleReviews.map((r: any) => (
            <div class="card review-card">
              <div class="review-author-row">
                <strong>{r.author}</strong>
                <span class="review-time">{r.time_description || 'Avis vérifié'}</span>
              </div>
              <div class="review-stars">
                {'★'.repeat(r.rating || 5)}{'☆'.repeat(5 - (r.rating || 5))}
              </div>
              <p class="review-text">{r.text}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <AdSlot slot="0123456789" />

    <!-- Guard Shifts Schedule -->
    <section class="shifts-schedule-section">
      <h2>Planning prévisionnel des gardes</h2>
      <p class="section-lead">
        Tours de garde officiels déclarés auprès de l'Ordre National des Pharmaciens pour {pharmacy.nom}.
      </p>

      {(pharmacy.shifts && pharmacy.shifts.length > 0) ? (
        <div class="tablewrap card">
          <table>
            <thead>
              <tr>
                <th>Type de Garde</th>
                <th>Début</th>
                <th>Fin</th>
                <th>Accès & Modalités</th>
              </tr>
            </thead>
            <tbody>
              {pharmacy.shifts.map((s: any) => (
                <tr>
                  <td>
                    <span class={`badge ${s.type === 'nuit' ? 'badge-night' : 'badge-garde'}`}>
                      {s.type === 'nuit' ? 'Garde de Nuit' : 'Dimanche / Férié'}
                    </span>
                  </td>
                  <td>{new Date(s.debut).toLocaleDateString('fr-FR', { weekday: 'short', day: 'numeric', month: 'short' })} à {new Date(s.debut).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })}</td>
                  <td>{new Date(s.fin).toLocaleDateString('fr-FR', { weekday: 'short', day: 'numeric', month: 'short' })} à {new Date(s.fin).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })}</td>
                  <td><small>{s.notes}</small></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="card note-box">
          <p>
            Cette officine assure les tours de garde rotatifs selon le calendrier établi par le syndicat pharmaceutique du département <strong>{dept.nom} ({dept.code})</strong>. En cas d'urgence en dehors des horaires d'ouverture habituels, contactez le <strong>3237</strong> ou le <strong>17</strong>.
          </p>
        </div>
      )}
    </section>

    <!-- Local FAQ -->
    <section class="faq-pharma-section">
      <h2>Questions fréquentes sur {pharmacy.nom}</h2>
      <div class="faq-list">
        {pharmaFaqLd.mainEntity.map(item => (
          <details class="faq-item">
            <summary class="faq-question">
              <span>{item.name}</span>
              <span class="faq-arrow">▼</span>
            </summary>
            <div class="faq-answer">
              <p>{item.acceptedAnswer.text}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
  .pharmacy-detail-page {
    padding: 2.5rem 0;
  }
  .pharma-hero-box {
    margin-bottom: 2rem;
  }
  .status-badge-row {
    display: flex;
    gap: 8px;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .badge-outline {
    background: transparent;
    border: 1px solid var(--line);
    color: var(--muted);
  }
  .badge-rating {
    background: var(--gold-bg);
    border: 1px solid var(--gold-border);
    color: var(--gold);
    font-weight: 700;
  }
  .pharma-full-address {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.15rem;
    color: var(--ink-secondary);
    margin: 0.6rem 0 1rem;
  }
  .pharma-full-address svg {
    color: var(--cross);
  }
  .editorial-summary {
    font-size: 1.05rem;
    color: var(--ink-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }
  .pharma-primary-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .btn-lg {
    padding: 14px 28px;
    font-size: 1.1rem;
  }
  .shift-alert-box {
    background: var(--gold-bg);
    border: 1px solid var(--gold-border);
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 2.5rem;
  }
  .shift-alert-icon {
    font-size: 2rem;
  }
  .shift-alert-box h3 {
    margin: 0 0 6px;
    color: var(--gold);
  }
  .shift-alert-box p {
    margin: 0 0 4px;
    font-size: 0.95rem;
  }
  .shift-time {
    font-weight: 700;
    color: var(--ink);
  }
  .pharma-photo-section {
    margin-bottom: 2.5rem;
  }
  .photo-card {
    padding: 0.8rem;
    overflow: hidden;
  }
  .front-img {
    width: 100%;
    max-height: 420px;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }
  .photo-caption {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0.6rem 0 0;
    text-align: center;
  }
  .reviews-section {
    margin-bottom: 2.5rem;
  }
  .reviews-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.2rem;
    flex-wrap: wrap;
    gap: 12px;
  }
  .rating-large-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--gold-bg);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    border: 1px solid var(--gold-border);
  }
  .rating-num {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--gold);
  }
  .stars {
    color: #f59e0b;
    font-size: 1rem;
  }
  .rating-label {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .review-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .review-author-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
  }
  .review-time {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .review-stars {
    color: #f59e0b;
    font-size: 0.95rem;
  }
  .review-text {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--ink-secondary);
    margin: 0;
  }
  .pharma-map-wrap {
    margin-bottom: 2.5rem;
  }
  .shifts-schedule-section {
    margin-bottom: 2.5rem;
  }
  .note-box {
    background: var(--surface-2);
  }
  .faq-pharma-section {
    margin-top: 3rem;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 1.2rem;
  }
  .faq-item {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .faq-question {
    padding: 1.1rem 1.4rem;
    font-weight: 700;
    font-size: 1.05rem;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .faq-arrow {
    color: var(--muted);
    font-size: 0.8rem;
    transition: transform 0.2s ease;
  }
  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
  }
  .faq-answer {
    padding: 0 1.4rem 1.2rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-secondary);
  }
</style>
