---
import Base from '../../../layouts/Base.astro';
import PharmacyCard from '../../../components/PharmacyCard.astro';
import PharmacyMap from '../../../components/PharmacyMap.astro';
import AdSlot from '../../../components/AdSlot.astro';
import LiveDateBadge from '../../../components/LiveDateBadge.astro';
import departements from '../../../data/departements.json';
import topCommunes from '../../../data/top-communes.json';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const shardsDir = path.resolve('./src/data/shards');
  const deptMap = new Map(departements.map(d => [d.code, d]));
  const shardCache = new Map();

  return topCommunes.map(commune => {
    const deptCode = commune.departementCode;
    const dept = deptMap.get(deptCode) || { code: deptCode, nom: deptCode, region: '' };

    if (!shardCache.has(deptCode)) {
      const shardFile = path.join(shardsDir, `${deptCode}.json`);
      if (fs.existsSync(shardFile)) {
        try {
          shardCache.set(deptCode, JSON.parse(fs.readFileSync(shardFile, 'utf-8')));
        } catch (e) {
          shardCache.set(deptCode, []);
        }
      } else {
        shardCache.set(deptCode, []);
      }
    }

    const deptPharmacies = shardCache.get(deptCode) || [];
    const communeNameLower = commune.nom.toLowerCase();
    const postal = commune.codePostal || '';

    let matched = deptPharmacies.filter((p: any) => {
      const pVille = (p.ville || '').toLowerCase();
      const pCp = p.codePostal || '';
      return pVille === communeNameLower || (postal && pCp.startsWith(postal.slice(0, 4)));
    });

    if (matched.length === 0) {
      matched = deptPharmacies.slice(0, 10);
    }

    return {
      params: {
        dept: deptCode,
        commune: commune.slug,
      },
      props: {
        commune,
        dept,
        pharmacies: matched,
      }
    };
  });
}

const { commune, dept, pharmacies } = Astro.props;

// Active guard shifts (open now)
const now = new Date();
const onGuardList = pharmacies.filter((p: any) => {
  if (p.isOpen24h) return true;
  return (p.shifts || []).some((s: any) => {
    const d = new Date(s.debut);
    const f = new Date(s.fin);
    return now >= d && now <= f;
  });
});

const closedList = pharmacies.filter((p: any) => !onGuardList.includes(p));

// Display list for primary section: if active guards exist, show them; otherwise show top 6 with clear notice
const primaryList = onGuardList.length > 0 ? onGuardList : pharmacies.slice(0, 8);

const center: [number, number] = (commune.lat && commune.lon)
  ? [commune.lat, commune.lon]
  : [48.8566, 2.3522];

const breadcrumbs = [
  { name: 'Pharmacie de garde', href: '/pharmacie-de-garde/' },
  { name: `${dept.nom} (${dept.code})`, href: `/pharmacie-de-garde/${dept.code}/` },
  { name: commune.nom, href: `/pharmacie-de-garde/${dept.code}/${commune.slug}/` },
];

// ItemList Schema.org
const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `Pharmacies de garde à ${commune.nom}`,
  "description": `Liste officielle des officines de pharmacie et gardes d'urgence à ${commune.nom} (${commune.codePostal || dept.code}).`,
  "numberOfItems": pharmacies.length,
  "itemListElement": pharmacies.map((p: any, idx: number) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "item": {
      "@type": "Pharmacy",
      "name": p.nom,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": p.adresse,
        "addressLocality": p.ville,
        "postalCode": p.codePostal,
        "addressCountry": "FR"
      },
      "telephone": p.telephone || undefined,
      "url": `https://pharmaciedegarde24.fr/pharmacie/${p.slug}/`
    }
  }))
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `Où trouver une pharmacie de garde aujourd'hui ou cette nuit à ${commune.nom} (${commune.codePostal || dept.code}) ?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `À ${commune.nom}, la garde de nuit (20h00 - 08h00) est assurée à volets fermés. Pour obtenir l'adresse de l'officine d'astreinte ou vous faire ouvrir, contactez le 3237 (Résogardes) ou présentez-vous au commissariat de police ou à la brigade de gendarmerie la plus proche (composez le 17) avec votre ordonnance médicale urgente.`
      }
    },
    {
      "@type": "Question",
      "name": `Quelles pharmacies sont ouvertes le dimanche à ${commune.nom} ?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Le dimanche entre 08h00 et 20h00, une ou plusieurs officines de garde sont ouvertes en libre accès à ${commune.nom} ou dans le secteur sanitaire de ${dept.nom}. Vous pouvez vous y rendre sans démarche policière préalable.`
      }
    },
    {
      "@type": "Question",
      "name": `Combien de pharmacies d'officine sont recensées à ${commune.nom} ?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `La commune de ${commune.nom} compte actuellement ${pharmacies.length} pharmacies d'officine répertoriées au fichier national officiel FINESS.`
      }
    },
    {
      "@type": "Question",
      "name": `Les honoraires de garde sont-ils remboursés par la Sécurité Sociale à ${commune.nom} ?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Oui, les honoraires légaux (5 € le dimanche et jours fériés, 8 € la nuit) sont intégralement remboursés à 100% par l'Assurance Maladie dès lors que vous présentez une prescription médicale urgente rédigée par un médecin en dehors des heures d'ouverture standard.`
      }
    }
  ]
};
---

<Base
  title={`Pharmacie de Garde à ${commune.nom} (${commune.codePostal || dept.code}) Aujourd'hui : Ouverte Maintenant et Nuit 24h`}
  description={`Trouvez les pharmacies de garde à ${commune.nom} ouvertes maintenant : horaires aujourd'hui, service de garde de nuit 24h/24, plan d'accès et téléphone direct pour appeler immédiatement.`}
  breadcrumbs={breadcrumbs}
  jsonLd={[itemListLd, faqLd]}
>
  <div class="wrap commune-page">
    <LiveDateBadge prefix="Situation en temps réel :" />

    <div class="commune-header">
      <div class="commune-badges">
        <span class="badge badge-open">Ville : {commune.nom}</span>
        <span class="badge badge-garde">{commune.codePostal || dept.code}</span>
        <span class="badge badge-night">
          {onGuardList.length > 0 ? `${onGuardList.length} de garde maintenant` : `${pharmacies.length} pharmacies`}
        </span>
      </div>
      <h1>Pharmacie de Garde à {commune.nom}</h1>
      <p class="lead">
        Officines actuellement ouvertes et service de garde d'urgence (dimanches, nuits et jours fériés) à <strong>{commune.nom}</strong> ({dept.nom}).
      </p>
    </div>

    <!-- Emergency notice -->
    <div class="card urg-notice-box">
      <div class="urg-notice-text">
        <span class="urg-notice-icon">🌙</span>
        <div>
          <h3>Garde de nuit à {commune.nom} (20h00 — 08h00)</h3>
          <p>
            Pour la sécurité des équipes officinales, les portes restent verrouillées. Présentez impérativement une <strong>ordonnance médicale urgente</strong> datée du jour. Si la sonnette n'est pas accessible, contactez le <strong>3237</strong> ou le <strong>17</strong>.
          </p>
        </div>
      </div>
      <div class="urg-notice-btns">
        <a href="tel:3237" class="btn btn-phone">3237 (Garde)</a>
        <a href="tel:17" class="btn btn-outline">Police / Gendarmerie 17</a>
      </div>
    </div>

    <!-- Clustered Map with Open-Only by default -->
    <section class="commune-map-section">
      <div class="map-section-title-row">
        <h2>Carte des pharmacies à {commune.nom}</h2>
        <span class="muted">Affichage par palloncino regroupé</span>
      </div>
      <PharmacyMap pharmacies={pharmacies} center={center} zoom={13} cityName={commune.nom} defaultOnlyOpen={true} />
    </section>

    <AdSlot slot="8901234567" />

    <!-- List of Open / On-Call Pharmacies -->
    <section class="commune-list-section">
      <div class="list-heading">
        <h2>
          {onGuardList.length > 0 
            ? `🟢 Pharmacies actuellement ouvertes et de garde à ${commune.nom} (${onGuardList.length})` 
            : `Pharmacies d'astreinte recommandées à ${commune.nom} (${primaryList.length})`}
        </h2>
        <span class="badge badge-open">Vérification en direct</span>
      </div>

      <div class="grid grid-cols-2 pharma-grid">
        {primaryList.map((p: any) => (
          <PharmacyCard pharmacy={p} />
        ))}
      </div>

      <!-- Collapsible for other closed pharmacies -->
      {closedList.length > 0 && onGuardList.length > 0 && (
        <details class="closed-accordion">
          <summary class="closed-summary">
            <span>📋 Afficher les {closedList.length} autres pharmacies de {commune.nom} (fermées actuellement)</span>
            <span class="accordion-arrow">▼</span>
          </summary>
          <div class="grid grid-cols-2 pharma-grid closed-grid">
            {closedList.map((p: any) => (
              <PharmacyCard pharmacy={p} />
            ))}
          </div>
        </details>
      )}
    </section>

    <AdSlot slot="9012345678" />

    <!-- Local FAQ -->
    <section class="commune-faq-section">
      <h2>Questions fréquentes — Pharmacie de garde à {commune.nom}</h2>
      <div class="faq-list">
        {faqLd.mainEntity.map(item => (
          <details class="faq-item">
            <summary class="faq-question">
              <span>{item.name}</span>
              <span class="faq-arrow">▼</span>
            </summary>
            <div class="faq-answer">
              <p>{item.acceptedAnswer.text}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
  .commune-page {
    padding: 2.5rem 0;
  }
  .commune-header {
    margin-bottom: 2rem;
  }
  .commune-badges {
    display: flex;
    gap: 8px;
    margin-bottom: 0.8rem;
    flex-wrap: wrap;
  }
  .urg-notice-box {
    background: var(--surface);
    border-left: 4px solid var(--gold);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }
  .urg-notice-text {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    max-width: 650px;
  }
  .urg-notice-icon {
    font-size: 2rem;
  }
  .urg-notice-text h3 {
    margin: 0 0 4px;
    color: var(--ink);
  }
  .urg-notice-text p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .urg-notice-btns {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .commune-map-section {
    margin-bottom: 2.5rem;
  }
  .map-section-title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 0.5rem;
  }
  .list-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.2rem;
    flex-wrap: wrap;
    gap: 8px;
  }
  .pharma-grid {
    margin-top: 1rem;
  }
  .closed-accordion {
    margin-top: 2rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .closed-summary {
    padding: 1rem 1.4rem;
    font-weight: 700;
    font-size: 1rem;
    color: var(--ink-secondary);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--surface-2);
    user-select: none;
  }
  .closed-summary:hover {
    color: var(--cross);
  }
  .accordion-arrow {
    font-size: 0.8rem;
    color: var(--muted);
    transition: transform 0.2s ease;
  }
  .closed-accordion[open] .accordion-arrow {
    transform: rotate(180deg);
  }
  .closed-grid {
    padding: 1.2rem;
  }
  .commune-faq-section {
    margin-top: 3.5rem;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 1.2rem;
  }
  .faq-item {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .faq-question {
    padding: 1.1rem 1.4rem;
    font-weight: 700;
    font-size: 1.05rem;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .faq-arrow {
    color: var(--muted);
    font-size: 0.8rem;
    transition: transform 0.2s ease;
  }
  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
  }
  .faq-answer {
    padding: 0 1.4rem 1.2rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-secondary);
  }
  @media (max-width: 768px) {
    .urg-notice-box {
      flex-direction: column;
      align-items: stretch;
    }
    .urg-notice-btns {
      flex-direction: column;
    }
  }
</style>
