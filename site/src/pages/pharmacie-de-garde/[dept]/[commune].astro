---
import Base from '../../../layouts/Base.astro';
import PharmacyCard from '../../../components/PharmacyCard.astro';
import PharmacyMap from '../../../components/PharmacyMap.astro';
import AdSlot from '../../../components/AdSlot.astro';
import LiveDateBadge from '../../../components/LiveDateBadge.astro';
import departements from '../../../data/departements.json';
import topCommunes from '../../../data/top-communes.json';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  function getDistanceKm(lat1: number, lon1: number, lat2: number, lon2: number): number {
    const R = 6371;
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLon = (lon2 - lon1) * Math.PI / 180;
    const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
              Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
              Math.sin(dLon / 2) * Math.sin(dLon / 2);
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }

  const shardsDir = path.resolve('./src/data/shards');
  const deptMap = new Map(departements.map(d => [d.code, d]));
  const shardCache = new Map();

  return topCommunes.map(commune => {
    const deptCode = commune.departementCode;
    const dept = deptMap.get(deptCode) || { code: deptCode, nom: deptCode, region: '' };

    if (!shardCache.has(deptCode)) {
      const shardFile = path.join(shardsDir, `${deptCode}.json`);
      if (fs.existsSync(shardFile)) {
        try {
          shardCache.set(deptCode, JSON.parse(fs.readFileSync(shardFile, 'utf-8')));
        } catch (e) {
          shardCache.set(deptCode, []);
        }
      } else {
        shardCache.set(deptCode, []);
      }
    }

    const deptPharmacies = shardCache.get(deptCode) || [];
    const communeNameLower = commune.nom.toLowerCase();
    const postal = commune.codePostal || '';
    const cLat = commune.lat;
    const cLon = commune.lon;

    // 1. Direct commune pharmacies
    const localPharmacies = deptPharmacies.filter((p: any) => {
      const pVille = (p.ville || '').toLowerCase();
      const pCp = p.codePostal || '';
      return pVille === communeNameLower || (postal && pCp.startsWith(postal.slice(0, 4)));
    }).map((p: any) => ({
      ...p,
      distanceKm: (cLat && cLon && p.lat && p.lon)
        ? Math.round(getDistanceKm(cLat, cLon, p.lat, p.lon) * 10) / 10
        : null,
      isLocal: true,
    }));

    // 2. Expand radius: Nearby pharmacies in neighbouring communes within 25 km
    let nearbyPharmacies: any[] = [];
    if (cLat && cLon) {
      const localIds = new Set(localPharmacies.map((p: any) => p.id));
      nearbyPharmacies = deptPharmacies
        .filter((p: any) => !localIds.has(p.id) && p.lat && p.lon)
        .map((p: any) => {
          const dist = getDistanceKm(cLat, cLon, p.lat, p.lon);
          return {
            ...p,
            distanceKm: Math.round(dist * 10) / 10,
            isLocal: false,
          };
        })
        .filter((p: any) => p.distanceKm <= 25)
        .sort((a: any, b: any) => a.distanceKm - b.distanceKm)
        .slice(0, 20);
    }

    // 3. Departmental 24h Hub
    const h24Candidate = deptPharmacies.find((p: any) => p.isOpen24h);
    let dept24hPharmacy: any = null;
    if (h24Candidate) {
      const dist = (cLat && cLon && h24Candidate.lat && h24Candidate.lon)
        ? Math.round(getDistanceKm(cLat, cLon, h24Candidate.lat, h24Candidate.lon) * 10) / 10
        : null;
      dept24hPharmacy = {
        ...h24Candidate,
        distanceKm: dist,
        isLocal: localPharmacies.some((p: any) => p.id === h24Candidate.id)
      };
    }

    const matched = [...localPharmacies, ...nearbyPharmacies];
    const finalPharmacies = matched.length > 0 ? matched : deptPharmacies.slice(0, 10);

    return {
      params: {
        dept: deptCode,
        commune: commune.slug,
      },
      props: {
        commune,
        dept,
        pharmacies: finalPharmacies,
        dept24hPharmacy,
      }
    };
  });
}

const { commune, dept, pharmacies, dept24hPharmacy } = Astro.props;

// Active guard shifts (open now)
const now = new Date();
const onGuardList = pharmacies.filter((p: any) => {
  if (p.isOpen24h) return true;
  return (p.shifts || []).some((s: any) => {
    const d = new Date(s.debut);
    const f = new Date(s.fin);
    return now >= d && now <= f;
  });
});

const localPharmacies = pharmacies.filter((p: any) => p.isLocal);
const nearbyPharmacies = pharmacies.filter((p: any) => !p.isLocal);

// Ensure primary guard list has active guards, or if none in this exact minute, nearest open/duty pharmacies (at least 4-6)
const primaryList = onGuardList.length >= 2
  ? onGuardList
  : [...onGuardList, ...pharmacies.filter((p: any) => !onGuardList.includes(p))].slice(0, 6);

const center: [number, number] = (commune.lat && commune.lon)
  ? [commune.lat, commune.lon]
  : [48.8566, 2.3522];

const breadcrumbs = [
  { name: 'Pharmacie de garde', href: '/pharmacie-de-garde/' },
  { name: `${dept.nom} (${dept.code})`, href: `/pharmacie-de-garde/${dept.code}/` },
  { name: commune.nom, href: `/pharmacie-de-garde/${dept.code}/${commune.slug}/` },
];

// ItemList Schema.org
const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `Pharmacies de garde à ${commune.nom}`,
  "description": `Liste officielle des officines de pharmacie et gardes d'urgence à ${commune.nom} (${commune.codePostal || dept.code}).`,
  "numberOfItems": pharmacies.length,
  "itemListElement": pharmacies.map((p: any, idx: number) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "item": {
      "@type": "Pharmacy",
      "name": p.nom,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": p.adresse,
        "addressLocality": p.ville,
        "postalCode": p.codePostal,
        "addressCountry": "FR"
      },
      "telephone": p.telephone || undefined,
      "url": `https://www.pharmaciedegarde24.fr/pharmacie/${p.slug}/`
    }
  }))
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `Où trouver une pharmacie de garde aujourd'hui ou cette nuit à ${commune.nom} (${commune.codePostal || dept.code}) ?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `À ${commune.nom}, la garde de nuit (20h00 - 08h00) est assurée à volets fermés. Pour obtenir l'adresse de l'officine d'astreinte ou vous faire ouvrir, contactez le 3237 (Résogardes) ou présentez-vous au commissariat de police ou à la brigade de gendarmerie la plus proche (composez le 17) avec votre ordonnance médicale urgente.`
      }
    },
    {
      "@type": "Question",
      "name": `Quelles pharmacies sont ouvertes le dimanche à ${commune.nom} ?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Le dimanche entre 08h00 et 20h00, une ou plusieurs officines de garde sont ouvertes en libre accès à ${commune.nom} ou dans le secteur sanitaire de ${dept.nom}. Vous pouvez vous y rendre sans démarche policière préalable.`
      }
    },
    {
      "@type": "Question",
      "name": `Combien de pharmacies d'officine sont recensées à ${commune.nom} ?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `La commune de ${commune.nom} compte actuellement ${pharmacies.length} pharmacies d'officine répertoriées au fichier national officiel FINESS.`
      }
    },
    {
      "@type": "Question",
      "name": `Les honoraires de garde sont-ils remboursés par la Sécurité Sociale à ${commune.nom} ?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Oui, les honoraires légaux (5 € le dimanche et jours fériés, 8 € la nuit) sont intégralement remboursés à 100% par l'Assurance Maladie dès lors que vous présentez une prescription médicale urgente rédigée par un médecin en dehors des heures d'ouverture standard.`
      }
    }
  ]
};
---

<Base
  title={`Pharmacie de Garde à ${commune.nom} (${commune.codePostal || dept.code}) Aujourd'hui : Ouverte Maintenant et Nuit 24h`}
  description={`Trouvez les pharmacies de garde à ${commune.nom} ouvertes maintenant : horaires aujourd'hui, service de garde de nuit 24h/24, plan d'accès et téléphone direct pour appeler immédiatement.`}
  breadcrumbs={breadcrumbs}
  jsonLd={[itemListLd, faqLd]}
>
  <div class="wrap commune-page">
    <LiveDateBadge prefix="Situation en temps réel :" />

    <div class="commune-header">
      <div class="commune-badges">
        <span class="badge badge-open">Ville : {commune.nom}</span>
        <span class="badge badge-garde">{commune.codePostal || dept.code}</span>
        <span class="badge badge-night">
          {onGuardList.length > 0 ? `${onGuardList.length} de garde maintenant` : `${pharmacies.length} pharmacies`}
        </span>
      </div>
      <h1>Pharmacie de Garde à {commune.nom}</h1>
      <p class="lead">
        Officines actuellement ouvertes et service de garde d'urgence (dimanches, nuits et jours fériés) à <strong>{commune.nom}</strong> ({dept.nom}).
      </p>
    </div>

    <!-- Emergency notice -->
    <div class="card urg-notice-box">
      <div class="urg-notice-text">
        <span class="urg-notice-icon">🌙</span>
        <div>
          <h3>Garde de nuit à {commune.nom} (20h00 — 08h00)</h3>
          <p>
            Pour la sécurité des équipes officinales, les portes restent verrouillées. Présentez impérativement une <strong>ordonnance médicale urgente</strong> datée du jour. Si la sonnette n'est pas accessible, contactez le <strong>3237</strong> ou le <strong>17</strong>.
          </p>
        </div>
      </div>
      <div class="urg-notice-btns">
        <a href="tel:3237" class="btn btn-phone">3237 (Garde)</a>
        <a href="tel:17" class="btn btn-outline">Police / Gendarmerie 17</a>
      </div>
    </div>

    <!-- Trust box: Pourquoi une seule pharmacie de garde ? -->
    <div class="card why-single-box">
      <div class="why-single-icon">💡</div>
      <div class="why-single-content">
        <h4>Pourquoi n'y a-t-il qu'une seule officine de garde par secteur ?</h4>
        <p>
          Conformément à <strong>l'article L. 5125-22 du Code de la santé publique</strong>, le service de garde d'urgence (nuit, dimanches et jours fériés) est mutualisé par secteur sanitaire. L'Agence Régionale de Santé (ARS) et le syndicat des pharmaciens désignent <strong>une seule pharmacie de garde active par secteur</strong> pour assurer la permanence des soins.
        </p>
        <p class="why-single-sub">
          Afin de vous garantir un accès rapide à un professionnel de santé en cas d'urgence, nous affichons l'officine de garde de <strong>{commune.nom}</strong> ainsi que les officines d'astreinte et de nuit des communes voisines dans un <strong>rayon élargi de 25 km</strong>.
        </p>
      </div>
    </div>

    <!-- Permanent Departmental 24/24 Hub -->
    {dept24hPharmacy && (
      <div class="card hub-24h-card">
        <div class="hub-header">
          <span class="badge badge-night">🚨 Hub d'urgence 24h/24 permanent</span>
          <span class="badge badge-open">Accès direct libre sans police</span>
          {dept24hPharmacy.distanceKm != null && (
            <span class="badge badge-dist">à {dept24hPharmacy.distanceKm} km de {commune.nom}</span>
          )}
        </div>
        <div class="hub-body">
          <div class="hub-info">
            <h3>{dept24hPharmacy.nom} ({dept24hPharmacy.ville})</h3>
            <p class="hub-addr">
              📍 {dept24hPharmacy.adresse} — Ouverte 24h/24 et 7j/7 sans interruption.
            </p>
            <p class="hub-desc">
              Cette grande officine assure une permanence continue jour et nuit. Vous pouvez vous y rendre directement en libre accès pour toute urgence médicale immédiate sans passer par le commissariat.
            </p>
          </div>
          <div class="hub-actions">
            {dept24hPharmacy.telephone && (
              <a href={`tel:${dept24hPharmacy.telephone.replace(/\s+/g, '')}`} class="btn btn-phone">
                📞 {dept24hPharmacy.telephone}
              </a>
            )}
            <a href={`https://www.google.com/maps/dir/?api=1&destination=${dept24hPharmacy.lat},${dept24hPharmacy.lon}`} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
              🗺️ Itinéraire direct
            </a>
          </div>
        </div>
      </div>
    )}

    <!-- Clustered Map with Open-Only by default -->
    <section class="commune-map-section">
      <div class="map-section-title-row">
        <h2>Carte des pharmacies à {commune.nom} et environs</h2>
        <span class="muted">Affichage par palloncino regroupé (Rayon 25 km)</span>
      </div>
      <PharmacyMap pharmacies={pharmacies} center={center} zoom={13} cityName={commune.nom} defaultOnlyOpen={true} />
    </section>

    <AdSlot slot="8901234567" />

    <!-- List of Open / On-Call Pharmacies (Expanded Radius) -->
    <section class="commune-list-section">
      <div class="list-heading">
        <div>
          <h2>🟢 Service de garde & urgences ouvert maintenant ({primaryList.length})</h2>
          <p class="section-subtitle">
            Officines de garde à <strong>{commune.nom}</strong> et dans les communes limitrophes (rayon jusqu'à 25 km)
          </p>
        </div>
        <span class="badge badge-open">Vérification en direct</span>
      </div>

      <div class="grid grid-cols-2 pharma-grid">
        {primaryList.map((p: any) => (
          <PharmacyCard pharmacy={p} />
        ))}
      </div>
    </section>

    <!-- All Local Pharmacies with regular weekday hours -->
    {localPharmacies.length > 0 && (
      <section class="commune-regular-section">
        <div class="list-heading">
          <div>
            <h2>📋 Toutes les pharmacies à {commune.nom} ({localPharmacies.length})</h2>
            <p class="section-subtitle">
              Adresses, téléphones et <strong>horaires réguliers d'ouverture en journée</strong> pour vos soins habituels
            </p>
          </div>
          <span class="badge badge-open">Officines FINESS</span>
        </div>

        <div class="grid grid-cols-2 pharma-grid">
          {localPharmacies.map((p: any) => (
            <PharmacyCard pharmacy={p} />
          ))}
        </div>
      </section>
    )}

    <AdSlot slot="9012345678" />

    <!-- Local FAQ -->
    <section class="commune-faq-section">
      <h2>Questions fréquentes — Pharmacie de garde à {commune.nom}</h2>
      <div class="faq-list">
        {faqLd.mainEntity.map(item => (
          <details class="faq-item">
            <summary class="faq-question">
              <span>{item.name}</span>
              <span class="faq-arrow">▼</span>
            </summary>
            <div class="faq-answer">
              <p>{item.acceptedAnswer.text}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
  .commune-page {
    padding: 2.5rem 0;
  }
  .commune-header {
    margin-bottom: 2rem;
  }
  .commune-badges {
    display: flex;
    gap: 8px;
    margin-bottom: 0.8rem;
    flex-wrap: wrap;
  }
  .urg-notice-box {
    background: var(--surface);
    border-left: 4px solid var(--gold);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }
  .urg-notice-text {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    max-width: 650px;
  }
  .urg-notice-icon {
    font-size: 2rem;
  }
  .urg-notice-text h3 {
    margin: 0 0 4px;
    color: var(--ink);
  }
  .urg-notice-text p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .urg-notice-btns {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .why-single-box {
    background: var(--surface);
    border-left: 4px solid var(--cross);
    display: flex;
    gap: 16px;
    align-items: flex-start;
    margin-bottom: 2rem;
    padding: 1.25rem 1.4rem;
  }
  .why-single-icon {
    font-size: 1.8rem;
    flex-shrink: 0;
  }
  .why-single-content h4 {
    margin: 0 0 6px;
    color: var(--ink);
    font-size: 1.05rem;
  }
  .why-single-content p {
    margin: 0 0 8px;
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .why-single-sub {
    color: var(--muted);
    font-size: 0.86rem !important;
    margin-bottom: 0 !important;
  }

  .hub-24h-card {
    background: linear-gradient(135deg, rgba(79, 70, 229, 0.08) 0%, rgba(16, 185, 129, 0.08) 100%);
    border: 1px solid var(--night-border);
    margin-bottom: 2.5rem;
    padding: 1.4rem;
  }
  .hub-header {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }
  .hub-body {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  .hub-info {
    max-width: 700px;
  }
  .hub-info h3 {
    margin: 0 0 4px;
    color: var(--ink);
    font-size: 1.2rem;
  }
  .hub-addr {
    font-weight: 600;
    color: var(--night);
    margin: 0 0 6px;
    font-size: 0.92rem;
  }
  .hub-desc {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-secondary);
  }
  .hub-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .section-subtitle {
    margin: 4px 0 0;
    font-size: 0.92rem;
    color: var(--muted);
  }

  .commune-regular-section {
    margin-top: 3.5rem;
  }
  .commune-map-section {
    margin-bottom: 2.5rem;
  }
  .map-section-title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 0.5rem;
  }
  .list-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.2rem;
    flex-wrap: wrap;
    gap: 8px;
  }
  .pharma-grid {
    margin-top: 1rem;
  }
  .closed-accordion {
    margin-top: 2rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .closed-summary {
    padding: 1rem 1.4rem;
    font-weight: 700;
    font-size: 1rem;
    color: var(--ink-secondary);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--surface-2);
    user-select: none;
  }
  .closed-summary:hover {
    color: var(--cross);
  }
  .accordion-arrow {
    font-size: 0.8rem;
    color: var(--muted);
    transition: transform 0.2s ease;
  }
  .closed-accordion[open] .accordion-arrow {
    transform: rotate(180deg);
  }
  .closed-grid {
    padding: 1.2rem;
  }
  .commune-faq-section {
    margin-top: 3.5rem;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 1.2rem;
  }
  .faq-item {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .faq-question {
    padding: 1.1rem 1.4rem;
    font-weight: 700;
    font-size: 1.05rem;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .faq-arrow {
    color: var(--muted);
    font-size: 0.8rem;
    transition: transform 0.2s ease;
  }
  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
  }
  .faq-answer {
    padding: 0 1.4rem 1.2rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-secondary);
  }
  @media (max-width: 768px) {
    .urg-notice-box {
      flex-direction: column;
      align-items: stretch;
    }
    .urg-notice-btns {
      flex-direction: column;
    }
  }
</style>
