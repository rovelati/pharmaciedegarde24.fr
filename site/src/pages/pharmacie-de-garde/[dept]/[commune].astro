---
import Base from '../../../layouts/Base.astro';
import PharmacyCard from '../../../components/PharmacyCard.astro';
import PharmacyMap from '../../../components/PharmacyMap.astro';
import AdSlot from '../../../components/AdSlot.astro';
import LiveDateBadge from '../../../components/LiveDateBadge.astro';
import departements from '../../../data/departements.json';
import topCommunes from '../../../data/top-communes.json';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  function getDistanceKm(lat1: number, lon1: number, lat2: number, lon2: number): number {
    const R = 6371;
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLon = (lon2 - lon1) * Math.PI / 180;
    const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
              Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
              Math.sin(dLon / 2) * Math.sin(dLon / 2);
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }

  const shardsDir = path.resolve('./src/data/shards');
  const deptMap = new Map(departements.map(d => [d.code, d]));
  const shardCache = new Map();

  return topCommunes.map(commune => {
    const deptCode = commune.departementCode;
    const dept = deptMap.get(deptCode) || { code: deptCode, nom: deptCode, region: '' };

    if (!shardCache.has(deptCode)) {
      const shardFile = path.join(shardsDir, `${deptCode}.json`);
      if (fs.existsSync(shardFile)) {
        try {
          shardCache.set(deptCode, JSON.parse(fs.readFileSync(shardFile, 'utf-8')));
        } catch (e) {
          shardCache.set(deptCode, []);
        }
      } else {
        shardCache.set(deptCode, []);
      }
    }

    const deptPharmacies = shardCache.get(deptCode) || [];
    const postalCodes = (commune.postalCodes && commune.postalCodes.length > 0)
      ? commune.postalCodes
      : (commune.codePostal ? [commune.codePostal] : []);
    const normCNom = (commune.nom || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/-/g, ' ').trim();
    const cLat = commune.lat;
    const cLon = commune.lon;

    // 1. Direct commune pharmacies (matched by postal code, exact or merged commune name)
    const localPharmacies = deptPharmacies.filter((p: any) => {
      const pCp = (p.codePostal || '').trim();
      if (postalCodes.includes(pCp)) return true;
      const normPVille = (p.ville || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/-/g, ' ').trim();
      if (normPVille === normCNom) return true;
      if (normCNom.split(' ').length > 1 && normCNom.includes(normPVille) && normPVille.length >= 4) return true;
      if (normPVille.includes(normCNom) && normCNom.length >= 4) return true;
      return false;
    }).map((p: any) => ({
      ...p,
      distanceKm: (cLat && cLon && p.lat && p.lon)
        ? Math.round(getDistanceKm(cLat, cLon, p.lat, p.lon) * 10) / 10
        : null,
      isLocal: true,
    })).sort((a: any, b: any) => (a.distanceKm || 0) - (b.distanceKm || 0));

    // 2. Expand radius: Nearby pharmacies in neighbouring communes within 15 km
    let nearbyPharmacies: any[] = [];
    if (cLat && cLon) {
      const localIds = new Set(localPharmacies.map((p: any) => p.id));
      nearbyPharmacies = deptPharmacies
        .filter((p: any) => !localIds.has(p.id) && p.lat && p.lon)
        .map((p: any) => {
          const dist = getDistanceKm(cLat, cLon, p.lat, p.lon);
          return {
            ...p,
            distanceKm: Math.round(dist * 10) / 10,
            isLocal: false,
          };
        })
        .filter((p: any) => p.distanceKm <= 15)
        .sort((a: any, b: any) => a.distanceKm - b.distanceKm)
        .slice(0, 16);
    }

    // 3. Departmental 24h Hub
    const h24Candidate = deptPharmacies.find((p: any) => p.isOpen24h);
    let dept24hPharmacy: any = null;
    if (h24Candidate) {
      const dist = (cLat && cLon && h24Candidate.lat && h24Candidate.lon)
        ? Math.round(getDistanceKm(cLat, cLon, h24Candidate.lat, h24Candidate.lon) * 10) / 10
        : null;
      dept24hPharmacy = {
        ...h24Candidate,
        distanceKm: dist,
        isLocal: localPharmacies.some((p: any) => p.id === h24Candidate.id)
      };
    }

    const matched = [...localPharmacies, ...nearbyPharmacies];
    const finalPharmacies = matched.length > 0 ? matched : deptPharmacies.slice(0, 10);

    return {
      params: {
        dept: deptCode,
        commune: commune.slug,
      },
      props: {
        commune,
        dept,
        pharmacies: finalPharmacies,
        dept24hPharmacy,
      }
    };
  });
}

const { commune, dept, pharmacies, dept24hPharmacy } = Astro.props;

const localPharmacies = pharmacies.filter((p: any) => p.isLocal);
const nearbyPharmacies = pharmacies.filter((p: any) => !p.isLocal);

// Postal code display (e.g. "69310, 69600" or single postal code)
const postalDisplay = (commune.postalCodes && commune.postalCodes.length > 0)
  ? (commune.postalCodes.length <= 3 ? commune.postalCodes.join(', ') : `${commune.postalCodes[0]} - ${commune.postalCodes[commune.postalCodes.length - 1]}`)
  : (commune.codePostal || dept.code);

// Active guard shifts (open now)
const now = new Date();
const onGuardList = pharmacies.filter((p: any) => {
  if (p.isOpen24h) return true;
  return (p.shifts || []).some((s: any) => {
    const d = new Date(s.debut);
    const f = new Date(s.fin);
    return now >= d && now <= f;
  });
});

// Primary emergency list (prioritizes 24h pharmacies and active guards, fallback to nearby 24h or scheduled)
const primaryEmergencyList = onGuardList.length > 0
  ? onGuardList
  : pharmacies.filter((p: any) => p.isOpen24h || (p.shifts && p.shifts.length > 0)).slice(0, 4);

const hasEmergencyPharmacies = primaryEmergencyList.length > 0 || !!dept24hPharmacy;

const center: [number, number] = (commune.lat && commune.lon)
  ? [commune.lat, commune.lon]
  : [48.8566, 2.3522];

const breadcrumbs = [
  { name: 'Pharmacie de garde', href: '/pharmacie-de-garde/' },
  { name: `${dept.nom} (${dept.code})`, href: `/pharmacie-de-garde/${dept.code}/` },
  { name: commune.nom, href: `/pharmacie-de-garde/${dept.code}/${commune.slug}/` },
];

// ItemList Schema.org
const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `Pharmacies de garde à ${commune.nom}`,
  "description": `Liste officielle des officines de pharmacie et gardes d'urgence à ${commune.nom} (${postalDisplay}).`,
  "numberOfItems": pharmacies.length,
  "itemListElement": pharmacies.map((p: any, idx: number) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "item": {
      "@type": "Pharmacy",
      "name": p.nom,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": p.adresse,
        "addressLocality": p.ville,
        "postalCode": p.codePostal,
        "addressCountry": "FR"
      },
      "telephone": p.telephone || undefined,
      "url": `https://www.pharmaciedegarde24.fr/pharmacie/${p.slug}/`
    }
  }))
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `Où trouver une pharmacie de garde aujourd'hui ou cette nuit à ${commune.nom} (${postalDisplay}) ?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `À ${commune.nom}, la garde de nuit (20h00 - 08h00) est assurée à volets fermés. Pour obtenir l'adresse de l'officine d'astreinte ou vous faire ouvrir, contactez le 3237 (Résogardes) ou présentez-vous au commissariat de police ou à la brigade de gendarmerie la plus proche (composez le 17) avec votre ordonnance médicale urgente.`
      }
    },
    {
      "@type": "Question",
      "name": `Quelles pharmacies sont ouvertes le dimanche à ${commune.nom} ?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Le dimanche entre 08h00 et 20h00, une ou plusieurs officines de garde sont ouvertes en libre accès à ${commune.nom} ou dans le secteur sanitaire de ${dept.nom}. Vous pouvez vous y rendre sans démarche policière préalable.`
      }
    },
    {
      "@type": "Question",
      "name": `Combien de pharmacies d'officine sont recensées à ${commune.nom} ?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `La commune de ${commune.nom} compte actuellement ${localPharmacies.length} pharmacies d'officine répertoriées au fichier national officiel FINESS (${pharmacies.length} avec les officines voisines).`
      }
    },
    {
      "@type": "Question",
      "name": `Les honoraires de garde sont-ils remboursés par la Sécurité Sociale à ${commune.nom} ?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Oui, les honoraires légaux (5 € le dimanche et jours fériés, 8 € la nuit) sont intégralement remboursés à 100% par l'Assurance Maladie dès lors que vous présentez une prescription médicale urgente rédigée par un médecin en dehors des heures d'ouverture standard.`
      }
    }
  ]
};
---

<Base
  title={`Pharmacie de Garde à ${commune.nom} (${postalDisplay}) : Ouverte Maintenant, Nuit et Dimanche`}
  description={`Trouvez les pharmacies de garde et ouvertes maintenant à ${commune.nom} (${postalDisplay}) : coordonnées, téléphones directs, horaires de jour et service d'urgence de nuit.`}
  breadcrumbs={breadcrumbs}
  jsonLd={[itemListLd, faqLd]}
>
  <div class="wrap commune-page">
    <LiveDateBadge prefix="Situation en temps réel :" />

    <div class="commune-header">
      <div class="commune-badges">
        <span class="badge badge-open">Ville : {commune.nom}</span>
        <span class="badge badge-garde">{postalDisplay}</span>
        <span class="badge badge-night">
          {localPharmacies.length} pharmacie{localPharmacies.length > 1 ? 's' : ''} à {commune.nom}
        </span>
        {nearbyPharmacies.length > 0 && (
          <span class="badge badge-dist">
            +{nearbyPharmacies.length} aux alentours
          </span>
        )}
      </div>
      <h1>Pharmacie de Garde à {commune.nom} ({postalDisplay})</h1>
      <p class="lead">
        Officines de proximité, permanence de nuit et service de garde d'urgence (dimanches et jours fériés) à <strong>{commune.nom}</strong> ({dept.nom}).
      </p>
    </div>

    <!-- Context notice: Daytime vs Night Guard (Mobile-first, compact emergency buttons) -->
    <div class="card urg-notice-box">
      <div class="urg-notice-text">
        <span class="urg-notice-icon">🚨</span>
        <div>
          <h3>Service d'urgence & de garde à {commune.nom}</h3>
          <p>
            <strong>Nuit (20h-8h), dimanches & jours fériés :</strong> La permanence s'effectue à volets fermés. En cas d'urgence avec ordonnance, contactez le <strong>3237</strong> ou présentez-vous au commissariat (<strong>17</strong>).
          </p>
        </div>
      </div>
      <div class="urg-notice-btns">
        <a href="tel:3237" class="btn btn-phone">📞 3237</a>
        <a href="tel:17" class="btn btn-outline">👮 17 Police</a>
        <a href="tel:15" class="btn btn-outline">🚑 15 SAMU</a>
      </div>
    </div>

    <!-- 1. Pharmacies de Garde & 24h/24 Actives (Priorité Absolue) -->
    {(primaryEmergencyList.length > 0 || dept24hPharmacy) && (
      <section class="commune-emergency-section">
        <div class="list-heading">
          <div>
            <h2>🚨 Officines de garde & 24h/24 ouvertes</h2>
            <p class="section-subtitle">
              Pharmacies assurant la permanence de nuit ou ouvertes en continu 24h/24
            </p>
          </div>
          <span class="badge badge-night">Urgences de garde</span>
        </div>

        {dept24hPharmacy && !primaryEmergencyList.some((p: any) => p.id === dept24hPharmacy.id) && (
          <div class="card hub-24h-card">
            <div class="hub-header">
              <span class="badge badge-night">🚨 Hub d'urgence 24h/24 permanent</span>
              <span class="badge badge-open">Accès libre 24h/24 sans police</span>
              {dept24hPharmacy.distanceKm != null && (
                <span class="badge badge-dist">à {dept24hPharmacy.distanceKm} km</span>
              )}
            </div>
            <div class="hub-body">
              <div class="hub-info">
                <h3>{dept24hPharmacy.nom} ({dept24hPharmacy.ville})</h3>
                <p class="hub-addr">📍 {dept24hPharmacy.adresse} — Ouverte 24h/24 et 7j/7 en continu.</p>
              </div>
              <div class="hub-actions">
                {dept24hPharmacy.telephone && (
                  <a href={`tel:${dept24hPharmacy.telephone.replace(/\s+/g, '')}`} class="btn btn-phone">
                    📞 {dept24hPharmacy.telephone}
                  </a>
                )}
                <a href={`https://www.google.com/maps/dir/?api=1&destination=${dept24hPharmacy.lat},${dept24hPharmacy.lon}`} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
                  🗺️ Itinéraire
                </a>
              </div>
            </div>
          </div>
        )}

        {primaryEmergencyList.length > 0 && (
          <div class="grid grid-cols-2 pharma-grid">
            {primaryEmergencyList.map((p: any) => (
              <PharmacyCard pharmacy={p} />
            ))}
          </div>
        )}
      </section>
    )}

    <!-- 2. Clustered Map (Auto-filtered to open/garde during night/Sunday) -->
    <section class="commune-map-section">
      <div class="map-section-title-row">
        <h2>🗺️ Carte des officines à {commune.nom} et alentours ({pharmacies.length})</h2>
        <span class="muted">Filtrage instantané sur les gardes & 24h</span>
      </div>
      <PharmacyMap pharmacies={pharmacies} center={center} zoom={13} cityName={commune.nom} defaultOnlyOpen={hasEmergencyPharmacies} />
    </section>

    <AdSlot slot="8901234567" />

    <!-- 3. Toutes les pharmacies en journée à la commune -->
    {localPharmacies.length > 0 && (
      <section class="commune-regular-section">
        {localPharmacies.length <= 8 ? (
          <div>
            <div class="list-heading">
              <div>
                <h2>📋 Toutes les pharmacies à {commune.nom} ({localPharmacies.length})</h2>
                <p class="section-subtitle">
                  Adresses, téléphones directs et <strong>horaires habituels en journée</strong>
                </p>
              </div>
              <span class="badge badge-open">Officines de la ville</span>
            </div>
            <div class="grid grid-cols-2 pharma-grid">
              {localPharmacies.map((p: any) => (
                <PharmacyCard pharmacy={p} />
              ))}
            </div>
          </div>
        ) : (
          <div class="regular-drawer-wrapper">
            <details class="regular-drawer">
              <summary class="regular-drawer-summary">
                <div class="drawer-summary-left">
                  <span class="drawer-icon">📋</span>
                  <div>
                    <span class="drawer-title">Consulter les {localPharmacies.length} pharmacies en journée à {commune.nom}</span>
                    <p class="drawer-sub">Horaires habituels de jour (cliquez pour déplier / rechercher dans la liste)</p>
                  </div>
                </div>
                <span class="drawer-toggle-badge">Afficher les {localPharmacies.length} officines ▼</span>
              </summary>
              <div class="drawer-content">
                <div class="drawer-search-bar">
                  <input
                    type="text"
                    id="filter-commune-pharmacies"
                    placeholder="🔍 Filtrer rapidement par nom, rue ou code postal..."
                    class="drawer-search-input"
                  />
                </div>
                <div class="grid grid-cols-2 pharma-grid" id="commune-pharmacies-grid">
                  {localPharmacies.map((p: any) => (
                    <div class="commune-pharma-item" data-search={`${p.nom} ${p.adresse} ${p.codePostal}`.toLowerCase()}>
                      <PharmacyCard pharmacy={p} />
                    </div>
                  ))}
                </div>
              </div>
            </details>
          </div>
        )}
      </section>
    )}

    <!-- 4. Pharmacies dans les communes limitrophes -->
    {nearbyPharmacies.length > 0 && (
      <section class="commune-nearby-section">
        <div class="list-heading">
          <div>
            <h2>📍 Pharmacies dans les communes voisines ({nearbyPharmacies.length})</h2>
            <p class="section-subtitle">
              Officines limitrophes à proximité de <strong>{commune.nom}</strong> (rayon 1 à 15 km)
            </p>
          </div>
          <span class="badge badge-dist">Communes limitrophes</span>
        </div>

        <div class="grid grid-cols-2 pharma-grid">
          {nearbyPharmacies.slice(0, 8).map((p: any) => (
            <PharmacyCard pharmacy={p} />
          ))}
        </div>
      </section>
    )}

    <!-- 5. Trust box: Pourquoi une seule pharmacie de garde ? (Placed below listings) -->
    <div class="card why-single-box">
      <div class="why-single-icon">💡</div>
      <div class="why-single-content">
        <h4>Pourquoi n'y a-t-il qu'une seule officine de garde par secteur ?</h4>
        <p>
          Conformément à <strong>l'article L. 5125-22 du Code de la santé publique</strong>, le service de garde d'urgence (nuit, dimanches et jours fériés) est mutualisé par secteur sanitaire. L'Agence Régionale de Santé (ARS) et le syndicat des pharmaciens désignent <strong>une seule pharmacie de garde active par secteur</strong> pour assurer la permanence des soins.
        </p>
        <p class="why-single-sub">
          Pour vous garantir un accès rapide à un professionnel de santé en cas d'urgence, nous affichons les officines de <strong>{commune.nom}</strong> ainsi que les officines des communes voisines dans un <strong>rayon élargi de 15 km</strong>.
        </p>
      </div>
    </div>

    <AdSlot slot="9012345678" />

    <!-- Local FAQ -->
    <section class="commune-faq-section">
      <h2>Questions fréquentes — Pharmacie de garde à {commune.nom}</h2>
      <div class="faq-list">
        {faqLd.mainEntity.map(item => (
          <details class="faq-item">
            <summary class="faq-question">
              <span>{item.name}</span>
              <span class="faq-arrow">▼</span>
            </summary>
            <div class="faq-answer">
              <p>{item.acceptedAnswer.text}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  </div>
</Base>

<!-- Client script for drawer filter -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('filter-commune-pharmacies');
    const grid = document.getElementById('commune-pharmacies-grid');
    if (!input || !grid) return;
    const items = grid.querySelectorAll('.commune-pharma-item');
    input.addEventListener('input', (e) => {
      const val = e.target.value.toLowerCase().trim();
      items.forEach(el => {
        const text = el.getAttribute('data-search') || '';
        el.style.display = (!val || text.includes(val)) ? '' : 'none';
      });
    });
  });
</script>

<style>
  .commune-page {
    padding: 2rem 0;
  }
  .commune-header {
    margin-bottom: 1.5rem;
  }
  .commune-badges {
    display: flex;
    gap: 8px;
    margin-bottom: 0.8rem;
    flex-wrap: wrap;
  }
  .urg-notice-box {
    background: var(--surface);
    border-left: 4px solid var(--gold);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    padding: 1.2rem 1.4rem;
  }
  .urg-notice-text {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    max-width: 650px;
  }
  .urg-notice-icon {
    font-size: 1.8rem;
  }
  .urg-notice-text h3 {
    margin: 0 0 4px;
    color: var(--ink);
    font-size: 1.1rem;
  }
  .urg-notice-text p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
  }
  .urg-notice-btns {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .commune-emergency-section {
    margin-bottom: 2rem;
  }
  .commune-map-section {
    margin-bottom: 2rem;
  }
  .map-section-title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 0.5rem;
  }
  .commune-regular-section {
    margin-top: 2rem;
    margin-bottom: 2rem;
  }
  .commune-nearby-section {
    margin-top: 2rem;
    margin-bottom: 2rem;
  }

  .regular-drawer-wrapper {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .regular-drawer-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
    cursor: pointer;
    background: var(--surface-2);
    user-select: none;
    transition: background 0.15s ease;
  }
  .regular-drawer-summary:hover {
    background: var(--surface-hover);
  }
  .drawer-summary-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .drawer-icon {
    font-size: 1.4rem;
  }
  .drawer-title {
    font-weight: 700;
    font-size: 1rem;
    color: var(--ink);
    display: block;
  }
  .drawer-sub {
    font-size: 0.82rem;
    color: var(--muted);
    margin: 2px 0 0;
  }
  .drawer-toggle-badge {
    font-size: 0.82rem;
    font-weight: 700;
    padding: 6px 12px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    color: var(--ink);
    white-space: nowrap;
  }
  .regular-drawer[open] .drawer-toggle-badge {
    background: var(--cross-bg);
    border-color: var(--cross-border);
    color: var(--cross);
  }
  .drawer-content {
    padding: 1rem 1.25rem 1.5rem;
  }
  .drawer-search-bar {
    margin-bottom: 1rem;
  }
  .drawer-search-input {
    width: 100%;
    padding: 8px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    font-size: 0.9rem;
    background: var(--surface);
    color: var(--ink);
  }
  .drawer-search-input:focus {
    outline: none;
    border-color: var(--cross);
    box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15);
  }

  .why-single-box {
    background: var(--surface);
    border-left: 4px solid var(--cross);
